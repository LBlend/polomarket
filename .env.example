# Database
DATABASE_URL="file:./dev.db"

# NextAuth
NEXTAUTH_URL="https://teampolomarket.com"
NEXTAUTH_SECRET="your-secret-here-generate-with-openssl-rand-base64-32"

# Google OAuth (https://console.cloud.google.com/)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# OwnTracks HTTP endpoint password (set this in the OwnTracks app)
OWNTRACKS_PASSWORD="your-secret-owntracks-password"

# Instagram Basic Display API (optional — shows placeholder if not set)
INSTAGRAM_ACCESS_TOKEN=""

# Rimcoin exchange rate (1 EUR = X rimcoins)
RIMCOIN_RATE="100"

NEXT_PUBLIC_UMAMI_WEBSITE_ID=your-website-id-here
NEXT_PUBLIC_UMAMI_SRC=https://umami.teampolomarket.com/script.js
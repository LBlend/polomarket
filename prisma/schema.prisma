generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// GPS track point sent by OwnTracks
model Location {
  id        String   @id @default(cuid())
  lat       Float
  lng       Float
  altitude  Float?
  speed     Float?
  accuracy  Float?
  battery   Int?
  tid       String?
  timestamp DateTime
  createdAt DateTime @default(now())
}

// Planned future stops on the route
model Waypoint {
  id          String   @id @default(cuid())
  lat         Float
  lng         Float
  name        String
  description String?
  order       Int      @default(0)
  visited     Boolean  @default(false)
  createdAt   DateTime @default(now())
}
